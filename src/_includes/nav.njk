{% from "components/nav-link.njk" import navLink %}

<nav>
  <ul class="flex flex-wrap items-center gap-0 py-2 border-b-2 mb-6">
    {{ navLink("/", "Inicio") }}
    {{ navLink("/about", "Sobre mim") }}
    {{ navLink("/fotos/", "Fotos") }}
    {{ navLink("/tags", "Tags") }}
    <li>
      <a href="/feed.xml" aria-label="RSS" title="RSS" class="inline-flex rounded-md p-2 text-ctp-text transition-colors duration-200 hover:text-ctp-mauve focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ctp-mauve dark:text-ctpd-text dark:hover:text-ctpd-mauve dark:focus-visible:outline-ctpd-mauve">
        <svg role="img" aria-label="RSS" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </li>
    <li>
        <button id="toggleDarkMode" class="cursor-pointer flex items-center gap-1 rounded-md p-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ctp-mauve dark:focus-visible:outline-ctpd-mauve">
            <img
                src="/assets/img/moon.svg"
                alt="Toggle Dark Mode"
                class="w-6 h-6 hidden dark:block"
            />
            <img
                src="/assets/img/sun.svg"
                alt="Toggle Light Mode"
                class="w-6 h-6 block dark:hidden"
            />
        </button>
    </li>
  </ul>
</nav>
