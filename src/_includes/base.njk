<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
  	<meta name='viewport' content='width=device-width'>

    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    <meta name="theme-color" content="#ffffff"/>
    <meta name="generator" content="{{ eleventy.generator }}">

    <link rel="icon" type="image/svg+xml" href="/assets/img/favicon/favicon.svg">
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml" />

    <link rel="preload" href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://unpkg.com/prismjs@1.20.0/themes/prism-okaidia.css"></noscript>
    <link href="/assets/styles/tailwind.css" rel="stylesheet" />
    <script>
      const isDarkMode = () => localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDarkMode()) {
        document.documentElement.classList.add('dark')
      } else {
        document.documentElement.classList.remove('dark')
      }
    </script>
  </head>

  <body class="bg-ctp-base dark:bg-ctpd-base text-ctp-text dark:text-ctpd-text">
    {{ content | safe }}
    
  <script>
    const toggle = document.getElementById("toggleDarkMode");
    if (toggle) {
      let themeTransitionTimeout;
      toggle.addEventListener("click", function() {
        const root = document.documentElement;
        root.classList.add('theme-transition');
        window.clearTimeout(themeTransitionTimeout);
        if (isDarkMode()) {
          localStorage.theme = 'light';
          root.classList.remove('dark');
        } else {
          localStorage.theme = 'dark';
          root.classList.add('dark');
        }
        window.dispatchEvent(new Event('themechange'));
        themeTransitionTimeout = window.setTimeout(() => {
          root.classList.remove('theme-transition');
        }, 350);
      });
    }
  </script>
  </body>
</html>
