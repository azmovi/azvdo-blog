{% set cover = photo.data.media[0] %}

<a href="{{ photo.url }}" aria-label="Abrir álbum: {{ photo.data.title }}" class="group relative block aspect-square overflow-hidden rounded-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ctp-mauve dark:focus-visible:outline-ctpd-mauve">
  <img src="{{ photo.url }}{{ cover.src | replace('./', '') }}" alt="{{ cover.alt }}" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-105">
  <span aria-hidden="true" class="absolute inset-x-0 bottom-0 flex items-end justify-between gap-2 bg-gradient-to-t from-black/80 to-transparent px-3 pb-3 pt-10 text-left text-sm text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100">
    <span class="font-medium">{{ photo.data.title }}</span>
    <time datetime="{{ photo.date | isoDate }}" class="shrink-0 text-xs">{{ photo.date | postDate }}</time>
  </span>
</a>
