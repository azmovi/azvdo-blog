---
layout: main
---

{% include "nav.njk" %}

<article class="mx-auto max-w-3xl">
  <header class="mb-4 flex items-baseline gap-2">
    <h1 class="text-lg font-semibold text-ctp-text dark:text-ctpd-text">{{ title }}</h1>
    <time datetime="{{ date | isoDate }}" class="shrink-0 text-sm text-ctp-subtext0 dark:text-ctpd-subtext0">{{ date | postDate }}</time>
  </header>

  <section class="photo-carousel" data-photo-carousel aria-label="Álbum: {{ title }}" aria-roledescription="carrossel">
    <div class="photo-carousel-track flex items-center snap-x snap-mandatory overflow-x-auto" data-carousel-track tabindex="0" aria-label="Fotos do álbum">
      {% for item in media %}
        <figure class="flex w-full shrink-0 snap-center flex-col items-center justify-center">
          {% if item.src | mediaType == "video" %}
            <video src="{{ item.src }}" controls playsinline preload="metadata" aria-label="{{ item.alt }}" class="block max-h-[80vh] max-w-full object-contain"></video>
          {% else %}
            <img src="{{ item.src }}" alt="{{ item.alt }}" {% if loop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async" class="block max-h-[80vh] max-w-full object-contain">
          {% endif %}
        </figure>
      {% endfor %}
    </div>

    {% if media | length > 1 %}
      <div class="mt-3 flex items-center justify-center gap-4">
        <button type="button" data-carousel-previous aria-label="Foto anterior" class="rounded-md px-3 py-2 text-ctp-mauve transition-colors hover:bg-ctp-mantle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ctp-mauve disabled:cursor-not-allowed disabled:opacity-40 dark:text-ctpd-mauve dark:hover:bg-ctpd-mantle dark:focus-visible:outline-ctpd-mauve">←</button>
        <span data-carousel-status aria-live="polite" class="min-w-12 text-center text-sm text-ctp-subtext0 dark:text-ctpd-subtext0">1 / {{ media | length }}</span>
        <button type="button" data-carousel-next aria-label="Próxima foto" class="rounded-md px-3 py-2 text-ctp-mauve transition-colors hover:bg-ctp-mantle focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ctp-mauve disabled:cursor-not-allowed disabled:opacity-40 dark:text-ctpd-mauve dark:hover:bg-ctpd-mantle dark:focus-visible:outline-ctpd-mauve">→</button>
      </div>
    {% endif %}
  </section>

  {% set recommendedPhotos = collections.photos | relatedPhotos(page.url, 4) %}
  {% if recommendedPhotos | length %}
    <section class="mt-10" aria-labelledby="more-photos-title">
      <h2 id="more-photos-title" class="mb-3 text-sm font-semibold text-ctp-subtext0 dark:text-ctpd-subtext0">Mais fotos</h2>
      <div class="grid grid-cols-4 gap-1 sm:gap-2">
        {% for photo in recommendedPhotos %}
          {% include "photo-card.njk" %}
        {% endfor %}
      </div>
    </section>
  {% endif %}
</article>

{% if media | length > 1 %}
  <script src="/assets/js/photo-carousel.js" defer></script>
{% endif %}
