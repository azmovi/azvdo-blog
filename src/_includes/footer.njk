{% from "components/footer-link.njk" import footerLink %}

<footer class="mt-12 border-t border-ctp-surface1 px-4 py-6 dark:border-ctpd-surface1 sm:px-8 sm:py-8">
  <div class="mx-auto flex max-w-screen-md flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="text-sm">
      <p>{{ site.name }}</p>
      <p class="mt-1 text-xs text-ctp-subtext0 dark:text-ctpd-subtext0">
        Conteúdo sob a licença
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.pt-br" target="_blank" rel="noopener noreferrer" class="underline hover:text-ctp-mauve dark:hover:text-ctpd-mauve">CC BY-NC-SA 4.0</a>.
      </p>
    </div>
    <nav aria-label="Contato e redes sociais">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm sm:justify-end">
      {% if site.github != "" %}
        {{ footerLink(site.github, "Github", true) }}
      {% endif %}

      {% if site.pixelfed != "" %}
        {{ footerLink(site.pixelfed, "Pixelfed", true) }}
      {% endif %}

      {% if site.email != "" %}
        {{ footerLink("mailto:" + site.email, "Email") }}
      {% endif %}
      </ul>
    </nav>

  </div>
</footer>
