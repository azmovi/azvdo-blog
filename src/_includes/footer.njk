<footer class="m-8 py-8 flex-shrink-0">
  <div class="max-w-screen-sm md:max-w-screen-md mx-auto flex justify-between items-center">
    <div class="text-sm py-2" >
      Antonio Cicero Azevedo
    </div>
    <p class="text-sm py-2 flex flex-wrap gap-4 justify-between items-center">
      {% if site.github != "" %}
        <a href="{{ site.github }}" target="_blank" rel="noopener noreferrer" class="hover:text-blue-500">Github</a>
      {% endif %}

      {% if site.pixelfed != "" %}
        <a href="{{ site.pixelfed }}" target="_blank" rel="noopener noreferrer" class="hover:text-blue-500">Pixelfed</a>
      {% endif %}

      {% if site.email != "" %}
        <a href="mailto:{{ site.email }}" class="hover:text-blue-500">Email</a>
      {% endif %}

    </p>

  </div>
</footer>

