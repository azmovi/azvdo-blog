{% if paginationNav.total > 1 %}
  <nav class="mt-8 flex justify-center" aria-label="Paginação">
    <div class="inline-flex items-center gap-4">
      {% if paginationNav.previous %}
        <a class="paginator-text" href="{{ paginationNav.previous }}">← Anterior</a>
      {% endif %}
      <span class="text-sm text-ctp-subtext0 dark:text-ctpd-subtext0">Página {{ paginationNav.current }} de {{ paginationNav.total }}</span>
      {% if paginationNav.next %}
        <a class="paginator-text" href="{{ paginationNav.next }}">Próxima →</a>
      {% endif %}
    </div>
  </nav>
{% endif %}
